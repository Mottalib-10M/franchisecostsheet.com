---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/franchise-payback-calculator/" title="Franchise payback calculator" width="100%" height="860" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the franchise payback calculator, free of charge" description="Small business blogs, newsrooms and resource pages can embed the franchise payback calculator with one iframe line. No cookie, no tracking, no lead form, no broker." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the franchise payback calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When a brand registers a new disclosure document and we load it, the embedded calculator follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the calculator visible, do not alter the frame, and do not place it next to a lead form, a broker offer or a loan application. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Payback, cash flow and break-even by brand</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/franchise-payback-calculator/" title="Franchise payback calculator" width="100%" height="860" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
